# Application Settings
APP_ENV=development
SECRET_KEY=tara-super-secret-jwt-key-replace-in-production-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tara

# Seed Configuration
SEED_PASSWORD=ChangeMe123!
SEED_TEST_PHONE_1=
SEED_TEST_PHONE_2=
SEED_TEST_PHONE_3=

# Bolna Voice AI Configuration
BOLNA_API_KEY=
BOLNA_API_BASE=https://api.bolna.ai
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
BOLNA_WEBHOOK_SECRET=

# Compliance & Safety Configuration
TEST_MODE=true
TEST_ALLOWLIST=
CALL_WINDOW_START=09:00
CALL_WINDOW_END=21:00
CONTACT_CAP_COUNT=2
CONTACT_CAP_DAYS=7

# Public URL (needed so Bolna can reach the webhook; use a tunnel such as cloudflared or ngrok in local dev)
PUBLIC_BASE_URL=http://localhost:8000
